# PRD v3.0 s26.3
APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=console

DATABASE_URL=postgresql+psycopg://ai:CHANGE_ME@localhost:5432/pharma_ai
LANGGRAPH_DATABASE_URL=postgresql://ai:CHANGE_ME@localhost:5432/pharma_ai

# --- OpenClaw gateway (s20.3, s28.3) --------------------------------------
# The worker never calls OpenAI or Anthropic directly; it calls the gateway and
# selects a configured OpenClaw agent route.
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=CHANGE_ME
OPENCLAW_EXECUTIVE_AGENT=pharma-executive
OPENCLAW_SPECIALIST_AGENT=pharma-specialist
OPENCLAW_TIMEOUT_SECONDS=900
OPENCLAW_LOCAL_AGENT=pharma-local

# Auth route. "subscription" is the s20.1 default; "api_key" is the s20.2
# fallback that MUST remain available. The gateway owns the credentials; this
# only records which route the deployment intends, so runs can be attributed.
OPENCLAW_AUTH_MODE=subscription

# --- Budgets (s12.2, s22) --------------------------------------------------
DEFAULT_MAX_SPECIALISTS=6
DEFAULT_MAX_PARALLEL_SPECIALISTS=4
DEFAULT_MAX_FOLLOWUP_ROUNDS=1
DEFAULT_MAX_RUNTIME_SECONDS=3600

# --- Artifacts and reports (s18, s32) --------------------------------------
ARTIFACT_STORAGE=local
ARTIFACT_LOCAL_PATH=./data/artifacts
REPORT_TEMPLATE=./templates/pharma_report_template.docx
REPORT_PDF_ENABLED=false

# --- Registry --------------------------------------------------------------
AGENT_DEFINITIONS_PATH=app/agents/definitions
WORKER_PROMPTS_PATH=app/prompts/workers
EXECUTIVE_PROMPTS_PATH=app/prompts/executive
# A15/A16 stay disabled until dedicated client SDS documents are approved (s11).
ENABLE_PROVISIONAL_PROFILES=false

# Slack user ids permitted to decide any run gate (s16). Empty means only the
# person who started a run may decide it.
SLACK_APPROVER_IDS=
